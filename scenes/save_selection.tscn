[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/save_selection.gd" id="1_selection"]

[node name="SaveSelection" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_selection")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 80
theme_override_constants/margin_top = 50
theme_override_constants/margin_right = 80
theme_override_constants/margin_bottom = 50

[node name="Layout" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="Margin/Layout"]
layout_mode = 2
theme_override_font_sizes/font_size = 28
text = "Spielstand laden"

[node name="Saves" type="ItemList" parent="Margin/Layout"]
layout_mode = 2
size_flags_vertical = 3

[node name="Info" type="Label" parent="Margin/Layout"]
layout_mode = 2
autowrap_mode = 2

[node name="Buttons" type="HBoxContainer" parent="Margin/Layout"]
layout_mode = 2

[node name="Load" type="Button" parent="Margin/Layout/Buttons"]
layout_mode = 2
text = "Laden"

[node name="Delete" type="Button" parent="Margin/Layout/Buttons"]
layout_mode = 2
text = "Löschen"

[node name="Cancel" type="Button" parent="Margin/Layout/Buttons"]
layout_mode = 2
text = "Zurück"

[node name="Confirmation" type="ConfirmationDialog" parent="."]
title = "Spielstand löschen"
ok_button_text = "Löschen"

[connection signal="pressed" from="Margin/Layout/Buttons/Load" to="." method="_on_load_pressed"]
[connection signal="pressed" from="Margin/Layout/Buttons/Delete" to="." method="_on_delete_pressed"]
[connection signal="pressed" from="Margin/Layout/Buttons/Cancel" to="." method="_on_cancel_pressed"]
[connection signal="confirmed" from="Confirmation" to="." method="_on_delete_confirmed"]
