[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/menu.gd" id="1_menu"]

[node name="Menu" type="Control"]
process_mode = 3
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_menu")

[node name="Backdrop" type="ColorRect" parent="."]
visible = false
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0, 0, 0, 0.8)

[node name="Panel" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Options" type="VBoxContainer" parent="Panel"]
custom_minimum_size = Vector2(360, 0)
layout_mode = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Panel/Options"]
layout_mode = 2
theme_override_font_sizes/font_size = 32
text = "OpenCrime"
horizontal_alignment = 1

[node name="Version" type="Label" parent="Panel/Options"]
layout_mode = 2
horizontal_alignment = 1

[node name="Resume" type="Button" parent="Panel/Options"]
visible = false
layout_mode = 2
text = "Spiel fortsetzen"

[node name="SinglePlayer" type="Button" parent="Panel/Options"]
layout_mode = 2
text = "Einzelspieler"

[node name="LoadGame" type="Button" parent="Panel/Options"]
layout_mode = 2
text = "Spielstand laden"

[node name="SaveGame" type="Button" parent="Panel/Options"]
visible = false
layout_mode = 2
text = "Spiel speichern"

[node name="SaveGameAs" type="Button" parent="Panel/Options"]
visible = false
layout_mode = 2
text = "Als neuen Spielstand speichern"

[node name="AddressLabel" type="Label" parent="Panel/Options"]
layout_mode = 2
text = "Serveradresse"

[node name="Address" type="LineEdit" parent="Panel/Options"]
layout_mode = 2
text = "127.0.0.1"
placeholder_text = "IP-Adresse oder Hostname"

[node name="PortLabel" type="Label" parent="Panel/Options"]
layout_mode = 2
text = "UDP-Port"

[node name="Port" type="LineEdit" parent="Panel/Options"]
layout_mode = 2
text = "7777"

[node name="Host" type="Button" parent="Panel/Options"]
layout_mode = 2
text = "Spiel hosten"

[node name="Join" type="Button" parent="Panel/Options"]
layout_mode = 2
text = "Spiel beitreten"

[node name="Message" type="Label" parent="Panel/Options"]
layout_mode = 2
autowrap_mode = 2

[node name="Changelog" type="Button" parent="Panel/Options"]
layout_mode = 2
text = "Änderungsprotokoll"

[node name="ReturnToMenu" type="Button" parent="Panel/Options"]
visible = false
layout_mode = 2
text = "Zum Hauptmenü"

[node name="Quit" type="Button" parent="Panel/Options"]
layout_mode = 2
text = "Spiel beenden"

[node name="ChangelogPanel" type="PanelContainer" parent="."]
visible = false
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 100.0
offset_top = 50.0
offset_right = -100.0
offset_bottom = -50.0
grow_horizontal = 2
grow_vertical = 2

[node name="Layout" type="VBoxContainer" parent="ChangelogPanel"]
layout_mode = 2

[node name="Content" type="RichTextLabel" parent="ChangelogPanel/Layout"]
layout_mode = 2
size_flags_vertical = 3
selection_enabled = true

[node name="Back" type="Button" parent="ChangelogPanel/Layout"]
layout_mode = 2
text = "Zurück"

[connection signal="pressed" from="Panel/Options/Resume" to="." method="_on_resume_pressed"]
[connection signal="pressed" from="Panel/Options/SinglePlayer" to="." method="_on_single_pressed"]
[connection signal="pressed" from="Panel/Options/LoadGame" to="." method="_on_load_pressed"]
[connection signal="pressed" from="Panel/Options/SaveGame" to="." method="_on_save_pressed"]
[connection signal="pressed" from="Panel/Options/SaveGameAs" to="." method="_on_save_as_pressed"]
[connection signal="pressed" from="Panel/Options/Host" to="." method="_on_host_pressed"]
[connection signal="pressed" from="Panel/Options/Join" to="." method="_on_join_pressed"]
[connection signal="pressed" from="Panel/Options/Changelog" to="." method="_on_changelog_pressed"]
[connection signal="pressed" from="Panel/Options/ReturnToMenu" to="." method="_on_return_to_menu_pressed"]
[connection signal="pressed" from="Panel/Options/Quit" to="." method="_on_quit_pressed"]
[connection signal="pressed" from="ChangelogPanel/Layout/Back" to="." method="_on_changelog_back_pressed"]
